// Robert Castellino site — Prisma schema
//
// This schema is groundwork. Public pages still read from src/data/*.ts
// until the DB is connected and populated; see src/lib/data-source.ts for
// the fallback layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Uploaded images live in the DB (bytea) — no external storage service.
// Served publicly from /api/images/[id]; the URL is saved on Musing.img / Photo.img.
// One row: the gift-series ad overrides (headlines, captions, chosen photos).
model GiftDraft {
  id        String   @id
  edits     Json
  images    Json
  updatedAt DateTime @updatedAt
}

model Image {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
}

// ───────── MUSINGS ─────────
enum MusingCategory {
  reflections
  light
  land
  locations
  wilderness
}

model Musing {
  id        String         @id // "m01" etc. — matches existing slugs
  num       String         // "M.001"
  cat       MusingCategory
  title     String
  date      String         // "Spring 2024" — human-readable, not a real date
  loc       String?
  img       String?
  size      String?        // "sm" | "md" | "lg"
  excerpt   String
  /// Paragraphs; may contain inline <em>...</em>
  body      String[]
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  order     Int            @default(0)

  @@index([cat])
  @@index([published, order])
}

// ───────── COLLECTIONS (gallery sections) ─────────
model Collection {
  id        String   @id @default(cuid())
  slug      String   @unique // "waterfalls", "reflections", etc.
  label     String
  intro     String
  order     Int      @default(0)
  published Boolean  @default(true)
  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Photo {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  img          String     // /assets/... or https://blob URL
  title        String
  loc          String
  blurb        String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId, order])
}

// ───────── CONTACT SUBMISSIONS ─────────
model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String
  // Optional metadata
  userAgent String?
  ipHash    String?
  // Workflow
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, archived, createdAt])
}

model PunchList {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ───────── NEWSLETTER SUBSCRIBERS ─────────
// Captured by the list-capture modal / journal CTA. Storage-only for now; a
// provider (Resend audience, etc.) can sync from here later.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // "popup" | "musings" | ...
  userAgent String?
  ipHash    String?
  confirmed Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, createdAt])
}

// ───────── SOCIAL POST DRAFTS ─────────
// Auto-generated from a published musing (one row per platform). Drafts for
// review, not auto-posted — no platform API credentials are wired.
model SocialDraft {
  id        String   @id @default(cuid())
  musingId  String // a musing id, or "post:<id>" for standalone Creator-page posts
  platform  String // "instagram" | "facebook" | "pinterest" | "reel" | "email"
  caption   String
  hashtags  String?
  link      String
  image     String?
  status    String   @default("draft") // draft | approved | posted | scheduled | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // ── Creator page queue (migration 0009): written back when the Post maker
  // publishes or schedules through Meta. All nullable; older rows are untouched.
  pillarId    String?
  metaPostId  String?
  scheduledAt DateTime?
  publishedAt DateTime?
  error       String?

  @@unique([musingId, platform])
  @@index([status, createdAt])
}

// ───────── META (FACEBOOK / INSTAGRAM) CONNECTION ─────────
// Single-row store for the OAuth tokens that let the app publish, schedule,
// and advertise on Bob's own Page/Instagram on his behalf. Populated by the
// Facebook Login flow in /api/admin/meta/*. The long-lived Page token does
// not normally expire; the user token is long-lived (~60 days) and is what
// `tokenExpiresAt` tracks so the UI can prompt a reconnect before it lapses.
model MetaConnection {
  id             String    @id @default("default") // singleton row
  fbUserId       String?
  fbUserName     String?
  fbUserToken    String? // long-lived user access token
  pageId         String?
  pageName       String?
  pageToken      String? // long-lived Page access token (used to publish)
  igUserId       String? // linked Instagram Business account id, when present
  igUsername     String?
  adAccountId    String? // e.g. "act_1788471615529613"
  scopes         String? // comma-separated granted permissions
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

// ───────── AD DRAFTS (Ads maker) ─────────
// One row per ad composed in /admin/ads. Submitting uploads the image,
// creates the creative + a PAUSED ad in Bob's ad account, and stores the
// Meta ids here. Status mirrors Meta's effective_status once live.
model AdDraft {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  imageHash   String?
  message     String
  headline    String
  description String?
  link        String
  ctaType     String   @default("SHOP_NOW")
  campaignId  String?
  adsetId     String?
  creativeId  String?
  metaAdId    String?
  status      String   @default("draft") // draft | submitted | active | paused | failed
  error       String?
  previewUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

// ═════════ CREATOR PAGE (/creator) — migration 0009 ═════════
// Ported from the built-with-ai / flowycash creator page. Additive only; the
// blog publishes into the existing Musing model and the library reads the
// existing Photo / Collection rows plus src/data/ad-images.json.

// ───────── BRAND ESSENCE (singleton, id "default") ─────────
// The one line, purpose, promise, do / don't lists, three voice dials (0–100),
// the CTA, plus the core messages and audiences as JSON. Every generator
// reads it through src/lib/creator/brand-context.ts.
model BrandEssence {
  id           String   @id @default("default")
  line         String   @default("")
  purpose      String   @default("")
  promise      String   @default("")
  doList       String[] @default([])
  dontList     String[] @default([])
  /// 0 = serious … 100 = playful
  voicePlayful Int      @default(50)
  /// 0 = casual … 100 = formal
  voiceFormal  Int      @default(50)
  /// 0 = gentle … 100 = bold
  voiceBold    Int      @default(50)
  cta          String   @default("")
  /// Core messages: [{ id, pillar, text, captions[], headlines[] }]
  messages     Json     @default("[]")
  /// Audiences: [{ id, name, sizeNote, source, subtype, status, ... }]
  audiences    Json     @default("[]")
  updatedAt    DateTime @updatedAt
}

// ───────── CONTENT PILLARS ─────────
// The brand messages every post / draft / image carries one of. `id` is the
// slug stored on SocialDraft.pillarId, LibraryTag.pillarId and EmailDraft.pillarId.
model Pillar {
  id        String   @id
  name      String
  /// One line: the brand message this pillar carries
  message   String
  /// Angle prompts — starting points for a title or a caption
  angles    String[] @default([])
  /// Default hashtags
  hashtags  String[] @default([])
  /// Target share of the content mix, in percent
  target    Int?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// ───────── BLOG SETTINGS (singleton, id "default") ─────────
// `tone` holds the BlogTone JSON (voice / audience / style / dos / donts)
// used by the blog generator, the caption writer and the newsletter.
model BlogSettings {
  id        String   @id @default("default")
  tone      Json
  updatedAt DateTime @updatedAt
}

// ───────── EMAIL DRAFTS ─────────
// Newsletters written by /creator/email from 1–3 published musings. Both
// renderings are stored (html + text). No ESP is wired: status is tracked by
// hand (proposed → ready → sent) and the HTML is copied out.
model EmailDraft {
  id        String   @id @default(cuid())
  name      String
  subject   String
  preheader String   @default("")
  html      String
  text      String
  pillarId  String?
  musingIds String[] @default([])
  status    String   @default("proposed") // proposed | ready | sent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ───────── LIBRARY TAGS ─────────
// Creator-page enrichment for an existing image, keyed by its site path
// (`/assets/…`). No bytes live here — the images stay where they are (public/
// or Photo.img). Seeded from the 93 master-Creator-page assets; editable later.
model LibraryTag {
  src       String   @id
  title     String?
  loc       String?
  blurb     String?
  pillarId  String?
  messageId String?
  inBook    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([pillarId])
}
